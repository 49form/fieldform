# NIST FTC-07 (an enclosure from the MBE PMI test cases), rebuilt from its drawing.
# Millimetres (the drawing is inches x 25.4). Z is up here; NIST's model has Y up, so compare with
# map=x,-z,y. Walls are tilted half-spaces cut by an envelope box, because a loft rounds small
# corners off a long outline and a right-angle blend of two planes is an exact drafted fillet.
#
# Run with:
#   fieldform --run benchmarks/reference-cad/ftc-07.ffc --exit
# from the repository root, on an empty document. It saves the part beside this script.

# body and flange
plane origin=152.4,0,0 turn=0,91,0 'BXp'
plane origin=-152.4,0,0 turn=0,-91,0 'BXm'
plane origin=0,107.95,0 turn=-91,0,0 'BYp'
plane origin=0,-107.95,0 turn=91,0,0 'BYm'
boolean in=BXp,BXm -i 'BX'
boolean in=BYp,BYm -i 'BY'
boolean in=BX,BY -i radius=3.048 'BWalls'
plane origin=0,0,-120.65 turn=180,0,0 'BFloor'
boolean in=BWalls,BFloor -i radius=3.048 'BOpen'
plane origin=0,0,12.7 'BTop'
boolean in=BOpen,BTop -i 'Body'
plane origin=152.4,0,0 turn=0,105,0 'FXp'
plane origin=-152.4,0,0 turn=0,-105,0 'FXm'
plane origin=0,107.95,0 turn=-105,0,0 'FYp'
plane origin=0,-107.95,0 turn=105,0,0 'FYm'
boolean in=FXp,FXm -i 'FX'
boolean in=FYp,FYm -i 'FY'
boolean in=FX,FY -i radius=3.048 'FWalls'
plane origin=0,0,12.7 'FTop'
plane origin=0,0,0 turn=180,0,0 'FBase'
boolean in=FWalls,FTop,FBase -i 'Flange'
# feet
line p0=133.3675,68.5625,-119.65 p1=133.3675,93.9975,-119.65 'ftpp0'
line p0=133.3675,93.9975,-119.65 p1=107.9325,93.9975,-119.65 'ftpp1'
line p0=107.9325,93.9975,-119.65 p1=107.9325,68.5625,-119.65 'ftpp2'
line p0=107.9325,68.5625,-119.65 p1=133.3675,68.5625,-119.65 'ftpp3'
extrude profile=ftpp0 height=-3.54 draft=-1 corners=sharp 'Padpp'
line p0=-107.9325,68.5625,-119.65 p1=-107.9325,93.9975,-119.65 'ftmp0'
line p0=-107.9325,93.9975,-119.65 p1=-133.3675,93.9975,-119.65 'ftmp1'
line p0=-133.3675,93.9975,-119.65 p1=-133.3675,68.5625,-119.65 'ftmp2'
line p0=-133.3675,68.5625,-119.65 p1=-107.9325,68.5625,-119.65 'ftmp3'
extrude profile=ftmp0 height=-3.54 draft=-1 corners=sharp 'Padmp'
line p0=-107.9325,-93.9975,-119.65 p1=-107.9325,-68.5625,-119.65 'ftmm0'
line p0=-107.9325,-68.5625,-119.65 p1=-133.3675,-68.5625,-119.65 'ftmm1'
line p0=-133.3675,-68.5625,-119.65 p1=-133.3675,-93.9975,-119.65 'ftmm2'
line p0=-133.3675,-93.9975,-119.65 p1=-107.9325,-93.9975,-119.65 'ftmm3'
extrude profile=ftmm0 height=-3.54 draft=-1 corners=sharp 'Padmm'
line p0=133.3675,-93.9975,-119.65 p1=133.3675,-68.5625,-119.65 'ftpm0'
line p0=133.3675,-68.5625,-119.65 p1=107.9325,-68.5625,-119.65 'ftpm1'
line p0=107.9325,-68.5625,-119.65 p1=107.9325,-93.9975,-119.65 'ftpm2'
line p0=107.9325,-93.9975,-119.65 p1=133.3675,-93.9975,-119.65 'ftpm3'
extrude profile=ftpm0 height=-3.54 draft=-1 corners=sharp 'Padpm'
boolean in=Body,Flange,Padpp,Padmp,Padmm,Padpm -u 'Shell'
# cavity
