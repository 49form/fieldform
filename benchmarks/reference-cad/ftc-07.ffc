extrude profile=bspm0 height=-15.24 draft=1 rims=1.524 rims_at=start 'Bosspm'
boolean in=Bosspp,Bossmp,Bossmm,Bosspm -u 'Bosses'
boolean in=Cavity,Bosses -s radius=1.524 'Pocket'
