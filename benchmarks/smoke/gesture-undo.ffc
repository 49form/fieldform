# Refactor plan step 2.2: a gesture does not outlive an undo.
#
# A drag goes on the history once because each new instant of it replaces the entry on top. After
# an undo the entry on top is the one *below* the drag's, so a quick edit that took itself for the
# drag's continuation replaced that one instead -- an edit nobody undid, dropped from the history
# with no way back to it.
#
# A file reaches this through the material, whose gesture folds any two edits inside 400 ms, and
# every line of a script runs inside one frame. The graph's own gesture is ended between lines by
# the runner, so a file cannot reach that one; the app's test
# `a_quick_edit_after_an_undo_never_replaces_the_entry_below` holds it.
#
# Run with:
#   fieldform.exe --run benchmarks/smoke/gesture-undo.ffc --keep-going --report gesture-undo.json --exit
# Exit code 0 when every expect passed.

# --- four entries a material edit must not swallow: a ball, a placement round it, two moves of it
sphere radius=10 centre=0,0,0 'ball'
move target=ball by=100,0,0 'moved'
move target=ball by=0,100,0
move target=ball by=0,0,100

# --- a material edit, taken back, and another straight after it. Not clay: clay is the default,
# so asking for it changes nothing and puts nothing on the history.
material preset=rubber
undo
material preset=chrome
undo

# Both histories leave the same document here; only what an undo reaches from it differs.
expect target=moved bbox=90,90,90,110,110,110 tol=0.5

# The last move comes off and the two before it stay. Before the fix the chrome had replaced the
# last move's entry, so this undo took off the move before it and put the ball back at 100,0,0.
# The tolerance is loose on purpose: the two answers are 100 mm apart, and what is checked is which
# entry survived, not how closely a sphere meshes.
undo
expect target=moved bbox=90,90,-10,110,110,10 tol=0.5
