+// What the grid knows about the cell holding `p`: a distance no point of that cell is nearer the
+// surface than, or nought where the grid cannot say. A lower bound on the reading `field` would
+// give at `p`, which is what lets it stand in for one -- see the top of `trace_primary`'s loop.
+fn cell_clearance(p: vec3<f32>) -> f32 {
+    if skip_grid[5] == 0u {
+        return 0.0;
+    }
+    let n = skip_f(3u);
+    let g = (p - vec3<f32>(skip_f(0u), skip_f(1u), skip_f(2u))) / skip_f(4u);
+    if any(g < vec3<f32>(0.0)) || any(g >= vec3<f32>(n)) {
+        return 0.0;
+    }
+    let at = vec3<u32>(g);
+    let side = u32(n);
+    return max(skip_f(SKIP_HEADER + (at.z * side + at.y) * side + at.x), 0.0);
+}
